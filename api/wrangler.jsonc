{
  // 챔로드 백엔드 API — Cloudflare Worker
  // 로컬 개발: npx wrangler dev  (http://localhost:8787)
  // 배포:      npx wrangler deploy  (최초 1회 npx wrangler login 필요)
  // 시크릿:    npx wrangler secret put PEPPER  (배포 전 필수 — .dev.vars 참고)
  "name": "chamroad-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  // 커스텀 도메인: api.chamroad.com (Cloudflare 존이 같은 계정에 있어 자동 프로비저닝).
  // 프로덕션 진입점은 api.chamroad.com 하나만 둔다. workers.dev를 함께 열면 커스텀
  // 도메인에 적용한 WAF/접근 정책을 우회할 수 있으므로 다음 배포부터 비활성화한다.
  "workers_dev": false,
  "routes": [
    { "pattern": "api.chamroad.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chamroad",
      "database_id": "a3de34d7-6d87-4f7e-abc0-8a1a3c5d6827"
    }
  ],
  "observability": { "enabled": true }
}
